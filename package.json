{
  "name": "awaiden-portfolio",
  "version": "1.0.0",
  "description": "awaiden's personal developer portfolio, project showcase, and interactive workspace built with Next.js 16, Base UI, adn-ui, Tailwind CSS v4, and 8-language i18n.",
  "keywords": [
    "adn-ui",
    "awaiden",
    "base-ui",
    "i18n",
    "nextjs",
    "portfolio",
    "react",
    "tailwindcss",
    "typescript"
  ],
  "homepage": "https://awaiden.com",
  "license": "MIT",
  "author": "awaiden (https://github.com/awaiden)",
  "repository": {
    "type": "git",
    "url": "https://github.com/awaiden/next.git"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "oxlint",
    "format": "oxfmt",
    "prepare": "husky"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.28.0",
    "next": "16.2.12",
    "next-themes": "^0.4.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.3.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.76.0",
    "postcss-tw-auto-reference": "^0.1.1",
    "shadcn": "^4.16.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "oxlint",
      "oxfmt"
    ],
    "*.{json,css,md}": [
      "oxfmt"
    ]
  },
  "engines": {
    "bun": ">=1.0.0",
    "node": ">=22.0.0"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
